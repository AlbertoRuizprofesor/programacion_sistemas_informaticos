package conectarDb;

import java.sql.Connection;
import java.sql.DriverManager;
import java.sql.SQLException;
import java.sql.Statement;

public class Productos {

    public static void main(String[] args) {
        String url = "jdbc:mysql://localhost/empresa1"; 
        String user = "root";
        String pass = "";

        // SINTAXIS MULTI-INSERT: VALUES (fila1), (fila2), (fila3)...
        // Nota: He quitado los ";" intermedios y añadido las comas faltantes
        String update = "INSERT INTO proveedores (id, nombre, precio) VALUES "
                      + "(1, 'Movil', '250'), "
                      + "(2, 'Auriculares', '50'), "
                      + "(3, 'Portatil', '670), "
                      + "(4, 'Radio', '98')";

        try (Connection conn = DriverManager.getConnection(url, user, pass);
             Statement stmt = conn.createStatement()) {
            
            int filasAfectadas = stmt.executeUpdate(update);
            System.out.println("Inserción masiva exitosa. Filas añadidas: " + filasAfectadas);

        } catch (SQLException e) {
            System.err.println("Error al insertar datos: " + e.getMessage());
            e.printStackTrace();
        }
    }
}