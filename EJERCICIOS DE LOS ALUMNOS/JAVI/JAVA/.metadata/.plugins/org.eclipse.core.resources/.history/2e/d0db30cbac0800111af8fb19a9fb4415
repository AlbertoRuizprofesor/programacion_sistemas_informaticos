package poobancos;

public class Main {
    public static void main(String[] args) {

        // 1. Creamos las cuentas
        CuentaBancaria c1 = new CuentaBancaria("Unicaja", 12345, 200.0);
        CuentaBancaria c2 = new CuentaBancaria("Santander", 67890, 1500.0);
        CuentaBancaria c3 = new CuentaBancaria("CaixaBank", 11223, 50.0);

        // 2. Creamos el array de clientes directamente
        Clientes[] listaClientes = {
            new Clientes("Paco", "12349999S", "600123123", c1),
            new Clientes("Lucía", "98765432B", "611222333", c2),
            new Clientes("Marcos", "44556677C", "644555666", c3)
        };

        // 3. Bucle For-Each para mostrar los datos
        System.out.println("=== LISTADO DE CLIENTES DEL BANCO ===");
        for (Clientes c : listaClientes) {
            c.mostrarDatosCliente();
            // Si quieres que cada uno muestre su saldo también:
            // c.getCuenta().mostrarSaldo(); 
            System.out.println("------------------------------------");
        }

        // 4. Ejemplo de operación individual sobre un elemento del array
        System.out.println("\nOperación especial para el primer cliente:");
        listaClientes[0].getCuenta().ingresar(100);
        listaClientes[0].getCuenta().mostrarSaldo();
    }
}