package interfaces;

public class Calculadora {
	
	public class Calculadora  implements Operaciones{

		@Override
		public int sumar(int a, int b) {
			
			return a+b;
		}
		
		@Override
		public int restar (int a, int b) {
			
			return a-b;
		}
		@Override
		public int multi (int a, int b) {
			return a*b;
		}	
		
		@Override
		public int divi (int a, int b){
			return a/b;
		}

		@Override
		public void mostrar(int a, int b) {
			System.out.println(" la suma es " +sumar(a,b));
			System.out.println(" la resta es " +restar(a,b));
			System.out.println(" la multi es " +multi(a, b));
			System.out.println(" la  division es  " +divi(a, b));
			
		}	
			
	}

	

}
