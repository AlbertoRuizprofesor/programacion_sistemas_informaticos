package Arrays;

import java.util.Scanner;

public class Notas1 {
	
	
	public double calcularSuma (double[] notas) {
		double suma = 0;
		for (double nota : notas) {
			suma = suma + nota;
		}
		return suma;
	}
	
	public double calcularMedia (double[] notas) {
		if (notas.length == 0) return 0;
		return calcularSuma(notas) / notas.length;
	}
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
