package Arrays;

import java.util.Scanner;

public class Notas1 {

	public double calcularSuma(double[] notas) {
		double suma = 0;
		for (double nota : notas) {
			suma = suma + nota;
		}
		return suma;
	}

	public double calcularMedia(double[] notas) {
		if (notas.length == 0)
			return 0;
		return calcularSuma(notas) / notas.length;
	}

	public double notasMax(double[] notas) {
		double maxima = notas[0];
		for (double nota : notas) {
			if (nota > maxima) {
				nota = maxima;
			}
		}
		return maxima;
	}

	public double notasMin(double[] notas) {
		double minima = notas[0];
		for (double nota : notas) {
			if (nota < minima) {
				nota = minima;
			}
		}
		return minima;
	}

	public void mostrarResultados(double[] notas) {
		double media = calcularMedia(notas);
		String[] metodos = { "Suma Total", "Media Final", "Nota Máxima", "Nota Mínima" };

		System.out.println("\n---- CALIFICACIONES ----");
		System.out.println(metodos[0] + " : " + calcularSuma(notas));
		System.out.println(metodos[1] + " : " + calcularMedia(notas));
		System.out.println(metodos[2] + " : " + notasMax(notas));
		System.out.println(metodos[3] + " : " + notasMin(notas));
	}

	public double[] pedirNotas() {
		Scanner teclado = new Scanner(System.in);

		System.out.print("¿Cuántas notas vas a introducir?: ");
		int cantidad = teclado.nextInt();

		double[] notas = new double[cantidad];

		for (int i = 0; i < notas.length; i++) {
			System.out.print("Introduce la nota " + (i + 1) + ": ");
			notas[i] = teclado.nextDouble();
		}

		return notas;
	}

}
