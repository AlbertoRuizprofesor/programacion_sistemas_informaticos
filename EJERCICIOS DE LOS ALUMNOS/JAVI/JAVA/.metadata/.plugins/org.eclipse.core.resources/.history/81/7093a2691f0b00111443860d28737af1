package conectarDb;

import java.sql.Connection;
import java.sql.DriverManager;
import java.sql.SQLException;
import java.sql.Statement;

public class Productos {

	public static void main(String[] args) {
		Connection conn = null;
		Statement stmt = null;

		// CORRECCIÓN: Quitamos la coma después de precio y cerramos el paréntesis ")"
		String sql = "CREATE TABLE IF NOT EXISTS productos (" + "id INT PRIMARY KEY, " + "nombre VARCHAR(60) NOT NULL, "
				+ "precio DOUBLE NOT NULL)"; // <-- Sin coma final y con cierre

		try {
			conn = DriverManager.getConnection("jdbc:mysql://localhost/empresa2", "root", "");

			stmt = conn.createStatement();
			stmt.execute(sql);
			System.out.println("La tabla 'productos' ha sido creada correctamente.");

		} catch (SQLException e) {
			System.err.println("Error de SQL: " + e.getMessage());
			e.printStackTrace();
		} finally {
			try {
				if (stmt != null)
					stmt.close();
				if (conn != null)
					conn.close();
			} catch (SQLException ex) {
				ex.printStackTrace();
			}
		}
	}

}
