package conectarDb.copy;

import java.sql.Connection;
import java.sql.DriverManager;
import java.sql.PreparedStatement;
import java.sql.SQLException;

public class Proveedores {

    public static void main(String[] args) {
        String url = "jdbc:mysql://localhost/empresa2"; 
        String user = "root";
        String pass = "";

        // Usamos la plantilla con 4 parámetros
        String sql = "INSERT INTO proveedores (id, nombre, telefono, email) VALUES (?, ?, ?, ?)";

        try (Connection conn = DriverManager.getConnection(url, user, pass);
             PreparedStatement pstmt = conn.prepareStatement(sql)) {

            // Proveedor 1
            pstmt.setInt(1, 1);
            pstmt.setString(2, "María");
            pstmt.setString(3, "666777888");
            pstmt.setString(4, "maria@gmail.com");
            pstmt.addBatch();

            // Proveedor 2
            pstmt.setInt(1, 2);
            pstmt.setString(2, "José");
            pstmt.setString(3, "666666888");
            pstmt.setString(4, "jose@gmail.com");
            pstmt.addBatch();

            // Proveedor 3
            pstmt.setInt(1, 3);
            pstmt.setString(2, "Juan");
            pstmt.setString(3, "6777778");
            pstmt.setString(4, "juan@gmail.com");
            pstmt.addBatch();

            // Proveedor 4
            pstmt.setInt(1, 4);
            pstmt.setString(2, "Manuel");
            pstmt.setString(3, "9888999");
            pstmt.setString(4, "manuel@gmail.com");
            pstmt.addBatch();

            // Ejecutamos todos los registros de una sola vez
            int[] resultados = pstmt.executeBatch();
            
            System.out.println("Inserción masiva exitosa. Proveedores añadidos: " + resultados.length);

        } catch (SQLException e) {
            System.err.println("Error al insertar proveedores: " + e.getMessage());
            e.printStackTrace();
        }
    }
}