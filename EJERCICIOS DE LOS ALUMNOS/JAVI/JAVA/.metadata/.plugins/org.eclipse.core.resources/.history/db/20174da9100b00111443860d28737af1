package conectarDb;

import java.sql.Connection; 
import java.sql.DriverManager; 
import java.sql.SQLException;
import java.sql.Statement;

public class CrearBaseDatos {

    public static void main(String[] args) {
        // Conexión al servidor (sin especificar la base de datos al principio)
        String url = "jdbc:mysql://localhost/"; 
        String user = "root";
        String pass = "";
        
        String sql = "CREATE DATABASE IF NOT EXISTS empresa1";

        // Usamos try-with-resources para que se cierren solos la conexión y el statement
        try (Connection conn = DriverManager.getConnection(url, user, pass);
             Statement stmt = conn.createStatement()) {
            
            // Ejecutamos la sentencia para crear la base de datos
            stmt.executeUpdate(sql);
            System.out.println("Base de datos creada o ya existente con éxito.");

        } catch (SQLException e) {
            System.err.println("Error al intentar crear la base de datos: " + e.getMessage());
            e.printStackTrace();
        }
    }
}