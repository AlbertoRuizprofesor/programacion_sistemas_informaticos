package conectarDb;

import java.sql.Connection;
import java.sql.DriverManager;
import java.sql.SQLException;
import java.sql.Statement;

public class Proveedores {

    public static void main(String[] args) {
        String url = "jdbc:mysql://localhost/empresa1"; 
        String user = "root";
        String pass = "";

        // SINTAXIS CORRECTA: INSERT INTO tabla (columnas) VALUES (valores)
        String update = "INSERT INTO empresa2.proveedores (id, nombre, teléfono, email) "
                      + "VALUES (1, 'María', '666777888' 'maria@gmail.com')";
        		      + "VALUES (2, 'José', '666666888' 'jose@gmail.com')";
        		      + "VALUES (3, 'Juan', '6777778' 'juan@gmail.com')";
        		      + "VALUES (4, 'Manuel', '9888999' 'manuel@gmail.com')";

        // Usamos try-with-resources para un código más limpio y seguro
        try (Connection conn = DriverManager.getConnection(url, user, pass);
             Statement stmt = conn.createStatement()) {
            
            // Usamos executeUpdate para INSERT, UPDATE o DELETE
            int filasAfectadas = stmt.executeUpdate(update);
            
            System.out.println("Inserción exitosa. Filas añadidas: " + filasAfectadas);

        } catch (SQLException e) {
            System.err.println("Error al insertar datos: " + e.getMessage());
            e.printStackTrace();
        }
    }
}